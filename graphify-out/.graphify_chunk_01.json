    {
      "id": "concept_fuzzy_mf_matching",
      "label": "Fuzzy MF Name Matching via pg_trgm",
      "file_type": "concept",
      "source_file": "internal/services/instrument_service.go",
      "source_location": "L89-L107",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses PostgreSQL pg_trgm similarity() function with threshold 0.55 to handle renamed mutual funds without creating duplicate instrument rows. Logs every fuzzy match for regression visibility."
    },
    {
      "id": "concept_fifo_cost_basis",
      "label": "FIFO Cost Basis Calculation",
      "file_type": "concept",
      "source_file": "internal/services/portfolio_calculator.go",
      "source_location": "L70-L171",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Uses FIFO lot matching for cost basis except for IndMoney platform which uses average cost because IndMoney SIP transactions are reported as aggregated amounts rather than individual lots."
    },
    {
      "id": "concept_ai_alloc_suggestion",
      "label": "AI-Driven Allocation Suggestion Pattern",
      "file_type": "concept",
      "source_file": "internal/services/allocation_ai.go",
      "source_location": "L123-L304",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "AI does NOT persist suggestions directly. It returns a reviewed suggestion set (AllocSuggestResult) that the frontend presents to the user, who then calls ApplyTargets to commit. This separation prevents accidental overwrite of user-set targets."
    },
    {
      "id": "concept_db_backed_ai_prompt",
      "label": "DB-Backed Editable AI Prompt",
      "file_type": "concept",
      "source_file": "internal/db/migrations/00029_allocation_prompt.sql",
